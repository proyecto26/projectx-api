# BASE SETTINGS
COMPOSE_PROJECT_NAME=projectx
NODE_ENV=development

# DATABASE SETTINGS
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=projectx_db
# Host port; inside docker compose the database is always db:5432
POSTGRES_PORT=5432
# "localhost" when running the api, migrations or the seed on the host.
# docker compose sets DATABASE_URL to db:5432 for its own containers.
POSTGRES_HOST=localhost
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public&connect_timeout=300"

# TEMPORAL SETTINGS
# Host ports; inside docker compose the server is always temporal:7233
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
# Address the api connects to when running on the host (docker compose overrides it)
TEMPORAL_HOST="localhost:${TEMPORAL_PORT}"
TEMPORAL_NAMESPACE=default
# Retention for the namespace when temporal-create-namespace has to create it
TEMPORAL_NAMESPACE_RETENTION=72h
# Task queue the api's worker polls and its client starts workflows on
TEMPORAL_TASK_QUEUE=api
# Extra search attributes to register, "Name:Type,Name:Type" (Email:Keyword is always registered)
# Types: Keyword, Text, Int, Double, Bool, Datetime, KeywordList
TEMPORAL_SEARCH_ATTRIBUTES=

# API SETTINGS
API_PORT=8081
# Host port for the Node.js inspector of the api container
API_DEBUG_PORT=9229
# Comma separated origins allowed by CORS
ALLOWED_ORIGINS=
LOG_LEVEL=info
# Service name in the logs (default: api)
# SERVICE_NAME=api
# Optional global route prefix, e.g. v1 (default: none)
# API_PREFIX=

# AUTHENTICATION
JWT_SECRET=your_secret_key_for_jwt
# Comma separated emails the seed promotes to the admin role
ADMIN_EMAILS=admin@example.com

# EMAIL SETTINGS
# Leave empty in development to print emails (and the login code) to the api logs instead of sending them
SENDGRID_API_KEY=
# REMEMBER TO USE A VALID SENDER EMAIL, more info: https://app.sendgrid.com/settings/sender_auth/senders
EMAIL_FROM=support@example.com
EMAIL_FROM_NAME=ProjectX
