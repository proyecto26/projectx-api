import { log, proxyActivities } from "@temporalio/workflow";

// Type-only import: workflow code is bundled for the Temporal sandbox and must
// not load NestJS or any other Node.js module at runtime.
import type { ActivitiesService } from "{{activitiesServiceImport}}";

export interface {{inputType}} {
  id: string;
}

export interface {{resultType}} {
  id: string;
  processedAt: string;
}

const { {{activity}} } = proxyActivities<ActivitiesService>({
  startToCloseTimeout: "10 seconds",
  retry: {
    initialInterval: "1s",
    maximumInterval: "10s",
    backoffCoefficient: 2,
    maximumAttempts: 5,
  },
});

/**
 * {{description}}
 *
 * Keep this function deterministic: no Date.now(), Math.random(), I/O or Node.js
 * APIs here. Anything with side effects belongs in an activity.
 */
export async function {{workflowFn}}(
  input: {{inputType}},
): Promise<{{resultType}}> {
  log.info("{{workflowFn}} started", { id: input.id });
  const result = await {{activity}}(input);
  log.info("{{workflowFn}} completed", { id: input.id });
  return result;
}
